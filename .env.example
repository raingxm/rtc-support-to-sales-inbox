# Copy this file to .env and load it before starting FastAPI.
# Use a key and model from the provider at OPENAI_BASE_URL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# For Quanzil, use https://quanzil.com/v1.

# Set a PostgreSQL connection URL to persist tickets and handoffs.
DATABASE_URL=
